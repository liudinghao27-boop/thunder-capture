# ============================================================
# 雷霆捕获系统 (Thunder Capture) — 环境变量配置
# ============================================================
# 复制此文件为 .env 并填入真实值:
#   cp .env.example .env
#
# 生产环境必须设置 THUNDER_SECRET_KEY 和 THUNDER_POSTGRES_PASSWORD，
# 切勿使用本文件中的默认值。
# ============================================================

# ── 运行环境 ──────────────────────────────────────────────
# development | production
THUNDER_ENV=development

# ── 安全 ──────────────────────────────────────────────────
# JWT / 加密密钥 (生产环境必须设置！不设置则拒绝启动)
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
THUNDER_SECRET_KEY=change-me-to-a-random-64-char-string

# 独立加密密钥 (可选；未设置时派生自 THUNDER_SECRET_KEY)
# THUNDER_ENCRYPTION_KEY=

# CORS 允许的来源 (逗号分隔，生产环境设置为实际域名或留空)
# 生产环境留空表示只允许同源请求
THUNDER_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 是否开放注册 (0=关闭，1=开启)。首个用户始终可注册。
THUNDER_ALLOW_REGISTRATION=0

# 默认管理员密码 (仅首次初始化使用，安装后请立即修改)
THUNDER_ADMIN_PASSWORD=change-me-immediately

# ── LLM API Keys ──────────────────────────────────────────
# DeepSeek (分类 + 回复生成)
THUNDER_DEEPSEEK_KEY=sk-your-deepseek-key

# 智谱 GLM (AutoGLM PhoneAgent)
THUNDER_ZHIPU_KEY=your-zhipu-key

# OpenAI (可选)
THUNDER_OPENAI_KEY=sk-your-openai-key
THUNDER_OPENAI_BASE=https://api.openai.com/v1

# ── 数据库 ────────────────────────────────────────────────
# SQLite 路径 (本地开发默认)
# THUNDER_DATABASE_URL=sqlite:///data/thunder.db

# Docker Compose PostgreSQL (推荐生产环境)
THUNDER_POSTGRES_USER=thunder
THUNDER_POSTGRES_PASSWORD=change-me-to-a-strong-password
THUNDER_POSTGRES_DB=thunder
THUNDER_DATABASE_URL=postgresql://thunder:change-me-to-a-strong-password@postgres:5432/thunder

# ── Redis / Celery ────────────────────────────────────────
THUNDER_REDIS_URL=redis://redis:6379/0

# ── 系统配置路径 ──────────────────────────────────────────
# 采集引擎 SQLite 路径 (默认: data/thunder_engine.db)
THUNDER_ENGINE_DB_PATH=data/thunder_engine.db

# ── Dify AI 工作流 (P1 — 替代硬编码 Prompt) ──────────────
# 配置后自动切换分类后端: DirectLLM(DeepSeek) → Dify Workflow
# 部署 Dify 后取消注释并填入:
# DIFY_API_URL=http://localhost:5001/v1
# DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxx

# Dify 批量大小 (默认 10)
# DIFY_BATCH_SIZE=10

# Dify 最大重试次数 (默认 3)
# DIFY_MAX_RETRIES=3

# Dify 请求超时秒数 (默认 120)
# DIFY_TIMEOUT=120

# ── 意图分类质量 ──────────────────────────────────────────
# 最低置信度阈值: high | medium | low (默认 high)
THUNDER_CLASSIFY_MIN_CONFIDENCE=high
