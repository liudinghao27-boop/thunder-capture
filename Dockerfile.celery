# Celery Worker for Thunder Capture
FROM python:3.12-slim

WORKDIR /app

# System deps for psycopg2 build
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Copy project metadata first for better layer caching
COPY pyproject.toml ./
COPY requirements ./requirements

# Install package with adapter dependencies (PostgreSQL, Alembic, Celery, Redis)
RUN pip install --no-cache-dir -e ".[adapters]"

# App code
COPY . .

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

CMD ["celery", "-A", "adapters.celery.app", "worker", "-l", "info", "-Q", "collect,classify,send", "-c", "4", "--max-tasks-per-child=50"]
