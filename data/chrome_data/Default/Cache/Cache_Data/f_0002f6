":0,"recommend_chapter_info":{"recommend_chapter_list":[{"desc":"引言","timestamp":0,"detail":"","points":[]},{"desc":"张先生的遭遇","timestamp":23000,"detail":"","points":[{"desc":"・分期乐套餐价高于分项购","detail":"1. 事件经过：张先生在分期乐购买美团现金券套装，误以为套餐价格更实惠，实际却比分项购买价格更高；2. 处理结果：记者介入调查后，分期乐平台最终为张先生办理了退款。","type":1}]},{"desc":"其他受害者的反馈","timestamp":55500,"detail":"","points":[{"desc":"・多地用户控诉分期乐违规","detail":"1. 利率超标：多位用户反映分期乐综合年化利率达36%，远超国家法定24%上限；2. 捆绑消费：用户购买的套餐含大量无用卡券，额外支出高额费用；3. 退款遭拒：用户要求退还无用权益费用，被平台以虚拟商品为由拒绝。","type":1}]},{"desc":"分期乐的问题","timestamp":170500,"detail":"","points":[{"desc":"・涉嫌高利放贷违规收费","detail":"1. 利率超标：用户借款年化利率多为36%，远超国家法定24%上限；2. 还款失衡：用户借款本金十几万，已还款额远超本金数倍。","type":1},{"desc":"・捆绑销售无效权益","detail":"1. 套餐构成：核心产品为实用立减金，搭配大量无用户需求的生活优惠券；2. 霸王条款：虚拟商品下单后不退不换，单方面免除自身责任；3. 用户损失：用户额外支出数千至数万元无用卡券费用。","type":1},{"desc":"・用户投诉维权无门","detail":"1. 合同缺失：用户早期借款合同无法查看，投诉缺乏依据；2. 退款受阻：用户要求退还不合理费用均遭平台拒绝。","type":1}]},{"desc":"记者的采访","timestamp":195000,"detail":"","points":[{"desc":"・被约谈后仍消极应对","detail":"1. 监管记录：2021年分期乐因个人信息保护不力被点名整改，2026年3月被国家金融监督管理总局约谈；2. 采访回应：工作人员回避利率问题，将事项推给客服，客服对用户投诉一概回避；3. 现状：平台仍正常运转，用户多数投诉问题未得到解决。","type":1}]},{"desc":"结语","timestamp":318500,"detail":"","points":[]}],"chapter_recommend_type":1,"chapter_abstract":"分期乐平台被指存在高利率、捆绑销售、虚拟商品不退换等问题，引发全国各地用户投诉。尽管分期乐曾被约谈并要求整改，但仍未解决用户集中反馈的问题。目前，用户仍在积极寻求解决方案。","chapter_recommend_source":2,"push_scene":[],"chapter_bar_color":null},"trends_infos":null,"chapter_bar_color":null,"flash_mob_trends":0,"ent_log_extra":{"log_extra":"{\"global_log_extra\":null,\"page_log_extra\":null,\"aweme_log_extra\":{\"ce_current_group_id\":\"7630758246852438254\",\"author_id\":\"62596527221\"},\"extra_log_extra\":null}"},"personal_page_botton_diagnose_style":0,"aweme_type_tags":""},{"aweme_id":"7628617824323972091","desc":"#第十三届中国网络视听大会 太硬核！成都影视城两座顶级高科技影棚启用，虚拟场景与实景拍摄无缝切换，一起沉浸式感受虚拟制片！#成都","create_time":1776175999,"author":{"uid":"62596527221","interest_tags":null,"nickname":"成都新闻广播","card_sort_priority":null,"user_tags":null,"avatar_thumb":{"uri":"100x1