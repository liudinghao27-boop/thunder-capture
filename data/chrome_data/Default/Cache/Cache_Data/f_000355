00,"detail":"","points":[]}],"chapter_recommend_type":1,"chapter_abstract":"中医认为五脏五窍之间存在着密切的联系，五脏各有其独特的功能，而五窍的数量与脏腑的功能和特点相匹配。心、肺、肝、脾各有一个对应的窍，而肾有两个对应的窍，这是因为肾主水藏精，需要水火平衡。此外，五窍的数量还与天地自然的规律相呼应，体现了天人合一的思想。","chapter_recommend_source":2,"push_scene":[],"chapter_bar_color":null},"trends_infos":null,"chapter_bar_color":null,"share_post_info":{"share_type":"video","is_open_platform":1,"open_platform_key":"aw7c4z4ej0o3efzd"},"flash_mob_trends":0,"ent_log_extra":{"log_extra":"{\"global_log_extra\":null,\"page_log_extra\":null,\"aweme_log_extra\":{\"ce_current_group_id\":\"7648563855781894025\",\"author_id\":\"109782134755\"},\"extra_log_extra\":null}"},"personal_page_botton_diagnose_style":0,"aweme_type_tags":""},{"aweme_id":"7648498903775788891","desc":"牙疼不是病","create_time":1780804923,"author":{"uid":"109782134755","interest_tags":null,"nickname":"神龙（下期6月15日-17日线下课开课）","card_sort_priority":null,"user_tags":null,"avatar_thumb":{"uri":"100x100/aweme-avatar/tos-cn-avt-0015_c64b237be42afc21fa8b5fc32d8e9daa","url_list":["https://p3-pc.douyinpic.com/aweme/100x100/aweme-avatar/tos-cn-avt-0015_c64b237be42afc21fa8b5fc32d8e9daa.jpeg?from=327834062"],"width":720,"height":720},"private_relation_list":null,"endorsement_info_list":null,"follow_status":0,"special_people_labels":null,"hide_self_recommend_interest":0,"familiar_visitor_user":null,"custom_verify":"","display_info":null,"card_entries_not_display":null,"user_permissions":null,"profile_component_disabled":null,"ban_user_functions":null,"share_info":{"share_url":"","share_weibo_desc":"","share_desc":"","share_title":"","share_qrcode_url":{"uri":"fab000092891fc17c15d","url_list":["https://p3-pc-sign.douyinpic.com/obj/fab000092891fc17c15d?lk3s=138a59ce&x-expires=1781474400&x-signature=pjeTHajXCb5ZnM0ZYjwZhOCLUBc%3D&from=327834062"],"width":720,"height":720},"share_title_myself":"","share_title_other":"","share_desc_info":""},"can_set_geofencing":null,"card_entries":null,"white_cover_url":null,"enterprise_verify_reason":"","is_ad_fake