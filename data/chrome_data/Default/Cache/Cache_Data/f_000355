k_largely_following":false,"friend_recommend_info":{"friend_recommend_source":10,"label_user_list":null,"disable_friend_recommend_guide_label":false},"enable_comment_sticker_rec":false,"video_share_edit_status":0,"is_24_story":0,"recommend_chapter_info":{"recommend_chapter_list":[{"desc":"引言","timestamp":1000,"detail":"","points":[]},{"desc":"外在表现","timestamp":29000,"detail":"","points":[{"desc":"・外在衰老根源在肾肝亏虚","detail":"1. 肾气透支：男子五八肾气衰，陈冠希早年因舆论创伤恐伤肾，肾精严重透支。\n2. 水不涵木：肾水亏虚无法滋养肝木，肝血不足致目失所养，眼角皱纹等显现。","type":1}]},{"desc":"生活状态","timestamp":74000,"detail":"","points":[{"desc":"・生活习惯加速皮肤衰老","detail":"1. 吸烟伤肺：烟性燥热入肺经，长期吸烟损肺阴，致皮肤干枯松弛。\n2. 不防晒耗阳：户外不防晒遭风邪侵袭，阳热外泄，心火亢肾水亏，阴阳离决。","type":1},{"desc":"・环境饮食致气血不足","detail":"1. 湿邪困脾：长期旅居潮湿环境，脾喜燥恶湿，运化功能下降。\n2. 素食搭配不当：素食若搭配不合理，易致气血生化无源，面部干瘪。","type":1},{"desc":"・创业压力伤脾耗心血","detail":"1. 思虑伤脾：创办潮牌CLOT压力大，思虑过度暗耗心血，损伤脾阳。\n2. 心脾两虚：心脾两虚者面色枯萎、肌肉松弛，精力不济。","type":1}]},{"desc":"心理状态","timestamp":160000,"detail":"","points":[{"desc":"・心理创伤致肝气郁结","detail":"1. 肝郁气滞：2008年事件后被封杀，创伤潜藏致肝气郁结，长期郁发循环成气滞血瘀。\n2. 血瘀显老：气滞血瘀致面色暗黄无光泽，皱纹早生，显沧桑感。","type":1},{"desc":"・豁达心态属阴阳调和","detail":"1. 心态转变：如今重心放家庭，从叛逆到慈父，自嘲豁达是高层次阴阳调和。\n2. 年轻本质：真正年轻是气血调和、五脏安稳、心态平和，非无皱纹。","type":1}]},{"desc":"结语","timestamp":213000,"detail":"","points":[]}],"chapter_recommend_type":1,"chapter_abstract":"从中医角度分析陈冠希快速衰老的原因，包括肾精透支、肝血不足、肺阴亏虚、脾土困乏、心火上浮等。他的生活习惯、心理状态和环境因素都对身体产生了负面影响。然而，现在的他更加关注家庭，展现出豁达的心态，这是一种更高层次的阴阳调和。真正的年轻在于气血调和、五脏安稳和心态平和。","chapter_recommend_source":2,"push_scene":[],"chapter_bar_color":null},"trends_infos":null,"chapter_bar_color":null,"flash_mob_trends":0,"ent_log_extra":{"log_extra":"{\"global_log_extra\":null,\"page_log_extra\":null,\"aweme_log_extra\":{\"ce_current_group_id\":\"7648078062013293294\",\"author_id\":\"109782134755\"},\"extra_log_extra\":null}"},"personal_page_botton_diagnose_style":0,"aweme_type_tags":""},{"aweme_id":"7647965451922097075","desc":"波的震动就是能量","create_time":1780680719,"author":{"uid":"109782134755","interest_tags":null,"nickname":"神龙（下期6月15日-17日线下课开课