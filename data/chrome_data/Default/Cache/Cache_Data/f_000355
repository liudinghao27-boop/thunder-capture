ing":false,"friend_recommend_info":{"friend_recommend_source":10,"label_user_list":null,"disable_friend_recommend_guide_label":false},"enable_comment_sticker_rec":false,"video_share_edit_status":0,"is_24_story":0,"recommend_chapter_info":{"recommend_chapter_list":[{"desc":"引言","timestamp":0,"detail":"","points":[]},{"desc":"智慧与福报","timestamp":16000,"detail":"","points":[{"desc":"・财富源于智慧与福报","detail":"1. 智慧属火金：心属火主神明决策，心火明亮可辨趋势、防忽悠；肺属金主气与规则，能将智慧转化为落地方案，定规矩守底线。\n2. 福报属土水：脾属土具承载化生特性，福报深者可化困难为机遇，吸引贵人；肾属水主藏精，肾精足者底气足、稳得住，易获信任与财富青睐。","type":1}]},{"desc":"财富的显化","timestamp":81500,"detail":"","points":[{"desc":"・财富显化靠肝木疏通","detail":"1. 肝木为通道：肝属木主生发条达，是财富流通桥梁，肝气舒畅则财路通畅，郁结则处处碰壁。\n2. 显化核心公式：智慧（火+金）作用于福报（土+水），经肝木疏通后，最终在物质世界显化为财富，契合中医五行相生原理。","type":1}]},{"desc":"经络与财富","timestamp":108000,"detail":"","points":[{"desc":"・三条经络影响财富获取","detail":"1. 胃经主承接：胃经为多气多血之经，不通则机会来临时身体紧张胃疼，承接不住福报。\n2. 胆经主决断：胆经不通会反复纠结、犹豫不决，错失机会。\n3. 三焦主气化：三焦主管全身气化，不通则心火无法下达肾水，行动力不足，难以获取财富。","type":1}]},{"desc":"天人合一","timestamp":142000,"detail":"","points":[{"desc":"・财富需顺天地节律","detail":"1. 四季对应行动：春肝气生发宜启动新项目，夏心火旺盛宜扩大影响力，长夏脾土当令宜整合资源，秋肺金肃降宜结算利润，冬肾水封藏宜储蓄反省。\n2. 福报源于积累：过往顺应节律积累的能量存款，使自身处于正确频率，运气优于他人。\n3. 财富本质：身体小宇宙与天地大宇宙同频共振的程度，智慧是调频方法，福报是稳定状态，财富是共振结晶。","type":1}]},{"desc":"结语","timestamp":180000,"detail":"","points":[]}],"chapter_recommend_type":1,"chapter_abstract":"财富是智慧和福报的显化，智慧属火和金，福报属土和水。财富的显化需要通过肝木疏通，而胃经、胆经、三焦经等经络影响财富。天人合一，顺应节律，积累福报，才能实现财富的自然流动。","chapter_recommend_source":2,"push_scene":[],"chapter_bar_color":null},"trends_infos":null,"chapter_bar_color":null,"flash_mob_trends":0,"ent_log_extra":{"log_extra":"{\"global_log_extra\":null,\"page_log_extra\":null,\"aweme_log_extra\":{\"ce_current_group_id\":\"7647148815464962670\",\"author_id\":\"109782134755\"},\"extra_log_extra\":null}"},"personal_page_botton_diagnose_style":0,"aweme_type_tags":""},{"aweme_id":"7647094327983116211","desc":"识神元神","create_time":1780477895,"author":{"uid":"109782134755","interest_tags":null,"nickname":"神龙（下期6月15日-17日线下课开课）","card