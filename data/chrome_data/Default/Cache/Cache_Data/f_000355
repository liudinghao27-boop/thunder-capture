r_altar_order_id":0,"star_altar_type":0,"item_id":0},"mark_largely_following":false,"friend_recommend_info":{"friend_recommend_source":10,"label_user_list":null,"disable_friend_recommend_guide_label":false},"enable_comment_sticker_rec":false,"video_share_edit_status":0,"is_24_story":0,"recommend_chapter_info":{"recommend_chapter_list":[{"desc":"引言","timestamp":0,"detail":"","points":[]},{"desc":"气血凝滞","timestamp":29000,"detail":"","points":[{"desc":"・痣源于气血凝滞","detail":"1. 中医依据：《黄帝内经》指出气血是生命根本，血为气之母、气为血之帅，气血凝滞为万病开端\n2. 形成原理：原本周流不息的气血受阻，流速变慢为涩、彻底停滞为淤，浊气浊水沉淀于皮肤形成痣","type":1}]},{"desc":"经络与脏腑","timestamp":78000,"detail":"","points":[{"desc":"・痣对应经络与脏腑","detail":"1. 经络关联：十二条经络内属脏腑、外络肢节，每条对应特定脏腑\n2. 实例提示：心经路线长痣提示心气不足、心血亏虚或心火淤积；肝经路线长痣提示肝气郁结，此类人群性格多隐忍压抑","type":1}]},{"desc":"情志与脏腑","timestamp":132000,"detail":"","points":[{"desc":"・痣是情志的物理投影","detail":"1. 脏腑情志对应：肝藏魂主怒、心藏神主喜、脾藏意主思、肺藏魄主悲、肾藏志主恐，脏腑兼具能量与情绪属性\n2. 逻辑链条：长期情绪刺激致脏腑功能失调，引发对应经络气血淤堵，最终显现为痣","type":1}]},{"desc":"从痣看命","timestamp":203000,"detail":"","points":[{"desc":"・痣反映命运运行模式","detail":"1. 命运本质：痣代表的内在能量运行模式决定命运，而非痣本身；性格、情绪、选择串联成命运轨迹\n2. 改命方法：调气血、通经络、修心，心平气和则血顺经络通、脏腑安，痣可变淡甚至消失","type":1}]},{"desc":"结语","timestamp":245000,"detail":"","points":[]}],"chapter_recommend_type":1,"chapter_abstract":"中医认为，脸上的痣并非偶然，而是五脏六腑通过经络发出的求救信号。气血凝滞、经络堵塞、脏腑失调等因素都可能导致痣的出现。此外，痣还反映了一个人的性格和命运。要改善身体状况，需调整气血、疏通经络、修养心性。","chapter_recommend_source":2,"push_scene":[],"chapter_bar_color":null},"trends_infos":null,"chapter_bar_color":null,"flash_mob_trends":0,"ent_log_extra":{"log_extra":"{\"global_log_extra\":null,\"page_log_extra\":null,\"aweme_log_extra\":{\"ce_current_group_id\":\"7647586546287477851\",\"author_id\":\"109782134755\"},\"extra_log_extra\":null}"},"personal_page_botton_diagnose_style":0,"aweme_type_tags":""},{"aweme_id":"7647416843707092146","desc":"万物皆有心起","create_time":1780552986,"author":{"uid":"109782134755","interest_tags":null,"nickname":"神龙（下期6月15日-17日线下课开课）","card_sort_priority":null,"user_tags":null,"avatar_thumb":{"uri":"10