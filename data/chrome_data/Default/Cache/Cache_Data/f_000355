0},"mark_largely_following":false,"friend_recommend_info":{"friend_recommend_source":10,"label_user_list":null,"disable_friend_recommend_guide_label":false},"enable_comment_sticker_rec":false,"video_share_edit_status":0,"is_24_story":0,"recommend_chapter_info":{"recommend_chapter_list":[{"desc":"引言","timestamp":1000,"detail":"","points":[]},{"desc":"流泪的第一层秘密","timestamp":11000,"detail":"","points":[{"desc":"・流泪是阴阳交感的标志","detail":"1. 中医溯源：泪为肝之液，源头在津液，调控在心神，津液靠阳气推动\n2. 核心判断：能流泪说明阴阳可交感，大病麻木者不流泪是阴阳气不相顺接","type":1}]},{"desc":"不同情绪下的眼泪","timestamp":34000,"detail":"","points":[{"desc":"・情绪对应不同脏腑经络","detail":"1. 中医口诀：怒伤肝、喜伤心、思伤脾、悲伤肺、恐伤肾\n2. 核心机制：不同情绪下的眼泪对应不同经络与脏腑气血","type":1},{"desc":"・过喜流泪的两种状态","detail":"1. 正常情况：偶尔喜极而泣是宣畅气息，卸除心火与肺气\n2. 异常预警：动辄笑到流泪无法自控，是心气不足、神不守舍的表现","type":1},{"desc":"・感动流泪有益健康","detail":"1. 情绪入肝：感动情绪使肝气调达，津液随气血运行至目\n2. 益处体现：哭后心里松快、眼睛明亮，可疏通肝经郁结","type":1},{"desc":"・痛苦流泪是身体自救","detail":"1. 病理机制：悲伤使肺气郁闭，引发气短胸闷\n2. 自救表现：哭出眼泪可排泄肺气，避免肺闭气机导致抑郁结节","type":1},{"desc":"・剧痛流泪耗损肝肾","detail":"1. 损伤根源：剧痛伤肾，肾主骨生髓，痛极会导致经脉痉挛\n2. 耗损表现：伴随冷汗、面色苍白，长期反复流泪会耗损肾精与肝血","type":1}]},{"desc":"流泪对人体的影响","timestamp":149000,"detail":"","points":[{"desc":"・流泪分三种类型","detail":"1. 分类依据：按对人体的好坏分为好泪、坏泪、假性无泪\n2. 核心差异：不同类型泪的形成原因与对身体的影响不同","type":1},{"desc":"・好泪的特征与益处","detail":"1. 典型类型：感动之泪、适度宣泄的痛苦之泪、气机宣畅的开心之泪\n2. 共同特征：哭后通透不累，眼泪清澈或微咸不粘稠，非深夜崩溃时流出\n3. 健康益处：疏肝解郁、宣肺排浊、宁心安神","type":1},{"desc":"・坏泪的特征与危害","detail":"1. 典型类型：长期压抑后暴哭、痛苦伴冷汗的泪、莫名流泪\n2. 特征表现：哭后眼干头晕、胸闷乏力\n3. 深层危害：本质是气随泪脱、精髓外泄，长期会导致慢性疲劳、甲减、月经不调","type":1},{"desc":"・假性无泪的警示意义","detail":"1. 中医解读：并非坚强，而是气机僵化、津液枯竭、心神瘀阻\n2. 关联病症：常见于重度抑郁、燥热伤阴、瘀血内结的人群\n3. 好转信号：能哭出来才是身体好转的表现","type":1}]},{"desc":"自测方法","timestamp":200500,"detail":"","points":[{"desc":"・流泪状态自测三要点","detail":"1. 感受判断：哭后是轻松通透还是疲惫不堪\n2. 状态判断：眼泪是自然顺畅流出还是硬挤而出\n3. 伴随症状：有无便秘、失眠、怕冷或怕热等表现","type":1}]},{"desc":"结语","timestamp":220000,"detail":"","points":[]}],"chapter_recommend_type":1,"chapter_abstract":"中医认为，流泪不仅是情绪的外溢，更是身体内部阴阳交感的标志。不同情绪下的眼泪走不同经络，影响不同脏腑气血。流泪分为好泪、坏泪和假性无泪，分别有不同影响。通过自测方法，可以判断流泪对身体的影响。流泪是身体的气象员，要学会听懂眼泪的语言。","chapter_recommend_source":2,"push_scene":[],"chapter_bar_color":null},"trends_infos":null,"chapter_bar_color":null,"flash_mob_trends":0,"ent_log_extra":{"log_extra":"{\"global_log_extra\":null,\"page_log_extra\":null,\"aweme_log_extra\":{\"ce_current_group_id\":\"7650102593579211443\",\"author_id\":\"109782134755\"},\"extra_log_extra\":null}"},"personal_page_botton_diagnose_style":0},{"aweme_id":"7650028700135080073","desc":"能量守恒","create_time":1781161107,"author":{"uid":"109782134755","interest_tags":null,"nickname":"神龙（下期6月15日-17日线下课开课）","card_sort_priority":null,"user_tags":null,"avatar_thumb":{"uri":"100x100/aweme-avatar/tos-cn-avt-0015_c64b237be42afc21fa8b5fc32d8e9daa","url_list":["https://p3-pc.douyinpic.com/aweme/100x100/aweme-avatar/tos-cn-avt-0015_c64b237be42afc21fa8b5fc32d8e9daa.jpeg?from=327834062"],"width":720,"height":720},"private_relation_list":null,"endorsement_info_list":null,"follow_status":0,"special_people_labels":null,"hide_self_recommend_interest":0,"familiar_visitor_user":null,"custom_verify":"","display_info":null,"card_entries_not_display":null,"user_permissions":null,"profile_component_disabled":null,"ban_user_functions":null,"share_info":{"share_url":"","share_weibo_desc":"","share_desc":"","share_title":"","share_qrcode_url":{"uri":"fab000092891fc17c15d","url_list":["https://p3-pc-sign.douyinpic.com/obj/fab000092891fc17c15d?lk3s=138a59ce&x-expires=1781474400&x-signature=pjeTHajXCb5ZnM0ZYjwZhOCLUBc%3D&from=327834062"],"width":720,"height":720},"share_title_myself":"","share_title_other":"","share_desc_info":""},"can_set_geofencing":null,"card_entries":null,"white_cover_url":null,"enterprise_verify_reason":"","is_ad_fake":false,"hide_others_recommend_interest":0,"signature_extra":null,"im_role_ids":null,"identity_labels":null,"personal_tag_list":null,"not_seen_item_id_list_v2":null,"link_item_list":null,"prevent_download":false,"profile_mob_params":null,"contrail_list":null,"data_label_list":null,"follower_statu