s_use_music":false,"original":0,"xigua_base_info":{"status":0,"star_altar_order_id":0,"star_altar_type":0,"item_id":0},"mark_largely_following":false,"friend_recommend_info":{"friend_recommend_source":10,"label_user_list":null,"disable_friend_recommend_guide_label":false},"enable_comment_sticker_rec":false,"video_share_edit_status":0,"is_24_story":0,"recommend_chapter_info":{"recommend_chapter_list":[{"desc":"引言","timestamp":0,"detail":"","points":[]},{"desc":"上医与下医","timestamp":14000,"detail":"","points":[]},{"desc":"治病逻辑","timestamp":67500,"detail":"","points":[{"desc":"・上医治未病的深层内涵","detail":"1. 表面认知：人们通常认为治未病是提前养生、体检；2. 核心本质：真正的治未病不以治病为目标，出自《黄帝内经》核心思想","type":1},{"desc":"・五行视角下的疾病本质","detail":"1. 人体模型：人体是木火土金水相生相克的小宇宙；2. 疾病根源：疾病并非器官损坏，而是五行生克链条失衡","type":1},{"desc":"・上下医看病逻辑差异","detail":"1. 下医逻辑：针对症状对抗治疗，如失眠开安神药、压住火的症状；2. 上医逻辑：追溯症状根源，分析五行失衡链条","type":1}]},{"desc":"上医的做法","timestamp":90500,"detail":"","points":[{"desc":"・下医对抗治疗的弊端","detail":"1. 症状压制：通过退烧、消炎、降压等强行克制，如金太强就用药压下去；2. 反弹风险：未解决根源问题，症状易反弹，慢性病增多","type":1},{"desc":"・上医的治病核心思路","detail":"1. 病为信号：疾病是身体系统失衡的提示；2. 调和扶正：通过调和阴阳、扶助正气，让系统恢复平衡","type":1}]},{"desc":"企业管理","timestamp":128500,"detail":"","points":[{"desc":"・三类企业管理思维对比","detail":"1. 下医思维：业绩下滑时换总监、打广告促销治标；2. 中医思维：调整流程、优化团队、改善产品治本；3. 上医思维：布局企业五行系统，从根源解决问题","type":1},{"desc":"・企业五行布局的核心要素","detail":"1. 战略属木：需具备可持续执行力；2. 品牌属火：要能生发带动；3. 产品属土：滋养客户需求；4. 制度属金：防控经营风险；5. 文化属水：滋养企业全局","type":1}]},{"desc":"结语","timestamp":162000,"detail":"","points":[]}],"chapter_recommend_type":1,"chapter_abstract":"真正的上医不治病，而是通过调和阴阳、扶助正气来调整身体系统的平衡。他们关注的是整个五行生克链条，而非仅仅针对症状。这种思维方式不仅适用于医疗，还可应用于企业管理、国家治理等领域。","chapter_recommend_source":2,"push_scene":[1],"chapter_bar_color":null},"trends_infos":null,"chapter_bar_color":null,"flash_mob_trends":0,"ent_log_extra":{"log_extra":"{\"global_log_extra\":null,\"page_log_extra\":null,\"aweme_log_extra\":{\"ce_current_group_id\":\"7650694859074040754\",\"author_id\":\"109782134755\"},\"extra_log_extra\":null}"}},{"aweme_id":"7650523607752271730"