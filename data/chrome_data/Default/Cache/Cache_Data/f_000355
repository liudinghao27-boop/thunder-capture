fo":{"friend_recommend_source":10,"label_user_list":null,"disable_friend_recommend_guide_label":false},"enable_comment_sticker_rec":false,"video_share_edit_status":0,"is_24_story":0,"recommend_chapter_info":{"recommend_chapter_list":[{"desc":"引言","timestamp":500,"detail":"","points":[]},{"desc":"儒家","timestamp":24500,"detail":"","points":[{"desc":"・儒家修入世秩序智慧","detail":"1. 核心内容：以仁义礼智信、君君臣臣父父子子为核心；2. 核心逻辑：在给定秩序内找准位置，恪尽职守；3. 存在局限：假设秩序固定，人是秩序遵循者而非制定者","type":1}]},{"desc":"道家","timestamp":40000,"detail":"","points":[{"desc":"・道家修退守天道智慧","detail":"1. 核心内容：修无为、自然、柔弱胜刚强；2. 核心逻辑：与天地同频，不妄为不争先；3. 存在局限：姿态为退守、不争，帝王仅修此则失责","type":1}]},{"desc":"佛家","timestamp":56000,"detail":"","points":[{"desc":"・佛家修出离解脱智慧","detail":"1. 核心内容：修出离、空性、放下；2. 核心逻辑：看破世间幻象，超越生死轮回；3. 存在局限：方向为出世间，帝王仅修此则弃责","type":1}]},{"desc":"帝王心","timestamp":71000,"detail":"","points":[{"desc":"・帝王心是统摄型能量格局","detail":"1. 核心内涵：以儒家规矩治世，以道家天道为纲，以佛家空性安心，以帝王权柄统摄一切；2. 核心区别：儒释道是顺服，帝王心是主宰；3. 核心定位：站在天地人三才交汇点，代天行权统御万有","type":1}]},{"desc":"五行","timestamp":108000,"detail":"","points":[{"desc":"・五行视角看帝王心降维性","detail":"1. 儒释道五行对应：儒家属土，承载秩序但不创造；道家属水，滋润万物但不主宰；佛家属金，斩断执念但不生发；2. 帝王心五行特质：五行俱全，可按需切换（木生发、金决断、火明辨、水深沉、土承载）；3. 降维本质：儒释道偏单行，帝王心五行通摄、随时调用","type":1}]},{"desc":"阴阳","timestamp":150000,"detail":"","points":[{"desc":"・阴阳视角看帝王心平衡术","detail":"1. 儒释道阴阳偏向：佛家偏阴出世，儒家偏阳入世，道家偏守柔；2. 帝王心阴阳要求：阳极而阴、阴极而阳，动态切换（刚柔明暗随时调整）；3. 天人合一本质：不是与天合一，而是作为天的执行者，让天通过自己运行","type":1}]},{"desc":"结语","timestamp":182000,"detail":"","points":[]}],"chapter_recommend_type":1,"chapter_abstract":"帝王心是一种超越儒释道的修行法门，强调成为自己生命的主宰。它融合了儒家的规矩、道家的天道、佛家的空性，以帝王之权柄统摄一切。帝王心要求在五行之间随时切换，实现阴阳的动态平衡，达到天人合一的境界。修帝王心可以让人主宰自己的命运，对自己的每一个念头和选择负责。","chapter_recommend_source":2,"push_scene":[1],"chapter_bar_color":null},"trends_infos":null,"chapter_bar_color":null,"flash_mob_trends":0,"ent_log_extra":{"log_extra":"{\"global_log_extra\":null,\"page_log_extra\":null,\"aweme_log_extra\":{\"ce_current_group_id\":\"7650523607752271730\",\"author_id\":\"109782134755\"},\"extra_log_extra\":null}"},"persona