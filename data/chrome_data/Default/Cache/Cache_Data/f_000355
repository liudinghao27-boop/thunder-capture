l,"distribute_circle":{"distribute_type":0,"campus_block_interaction":false,"is_campus":false},"image_crop_ctrl":0,"yumme_recreason":null,"slides_music_beats":null,"jump_tab_info_list":null,"media_type":4,"play_progress":{"play_progress":0,"last_modified_time":0},"reply_smart_emojis":null,"activity_video_type":0,"boost_status":0,"create_scale_type":null,"entertainment_product_info":{"sub_title":null,"market_info":{"limit_free":{"in_free":false},"marketing_tag":null}},"caption":"","item_title":"健身好还是养生好","is_use_music":false,"original":0,"xigua_base_info":{"status":0,"star_altar_order_id":0,"star_altar_type":0,"item_id":0},"mark_largely_following":false,"friend_recommend_info":{"friend_recommend_source":10,"label_user_list":null,"disable_friend_recommend_guide_label":false},"enable_comment_sticker_rec":false,"video_share_edit_status":0,"is_24_story":0,"recommend_chapter_info":{"recommend_chapter_list":[{"desc":"引言","timestamp":1500,"detail":"","points":[]},{"desc":"健身与养生的本质区别","timestamp":17000,"detail":"","points":[{"desc":"・健身与养生本质差异","detail":"1. 健身核心：追求形态功能，底层逻辑是破坏后重建，属于耗氧过程，以高强度消耗换取短期身体指标提升。\n2. 养生核心：追求能量平衡，底层逻辑是开源节流，属于养阳过程，以养护精气神实现五脏安和、气血通畅。","type":1}]},{"desc":"饮食","timestamp":42000,"detail":"","points":[{"desc":"・健身饮食的中医弊端","detail":"1. 脾胃负担：大量摄入水煮鸡胸肉等高蛋白食物，加重脾胃虚弱者的中焦负担，消耗大量肾阳与脾气。\n2. 损伤脾阳：冰美式、生冷沙拉等寒凉饮食，会耗损脾胃之火，长期易致脾阳受损、内生寒湿，出现舌边齿痕。","type":1},{"desc":"・中医养生饮食原则","detail":"1. 五谷温养：以五谷、小米粥养护胃气，姜枣茶温中焦，注重温性食物摄入。\n2. 养气护根：饮食核心是养气，守护身体根本机能。","type":1}]},{"desc":"作息","timestamp":82500,"detail":"","points":[{"desc":"・健身作息的中医危害","detail":"1. 拔肾根：晚上高强度健身，迫使本该收藏的阳气外泄，违背“日出而作日落而息”规律，耗损肾精。\n2. 内里虚耗：长期如此会引发失眠、腰酸、免疫力下降，看似强壮实则内里空虚。","type":1},{"desc":"・中医养生作息原则","detail":"1. 顺时起居：子时前入睡养护胆气肝血，太阳升起后再运动。\n2. 适度运动：运动以微汗为度，避免大汗，因“汗为心之液”，大汗会耗损心液。","type":1}]},{"desc":"健身的优劣势","timestamp":120000,"detail":"","points":[{"desc":"・健身的优势","detail":"1. 提升机能：可提高心肺功能，增加肌肉量，短期内提升新陈代谢。\n2. 改善体态：让身形更挺拔，久坐人群适度锻炼有益。","type":1},{"desc":"・健身的弊端","detail":"1. 损伤筋骨：中高强度训练易导致膝盖、腰椎、肩周等部位筋缩错位。\n2. 弱化脾胃：高蛋白加寒凉饮食，加重脾胃虚弱，引发胀气、消化不良。\n3. 耗损肾精：过度训练可能透支肾精，极端情况引发横纹肌溶解，导致身体早衰。","type":1}]},{"desc":"中医养生的优劣势","timestamp":164500,"detail":"","points":[{"desc":"・中医养生的劣势","detail":"1. 见效缓慢：无即时训练泵感，不适合急于求成的人群。","type":1},{"desc":"・中医养生的优势","detail":"1. 养护内在：注重提升五脏六腑机能，从根源维护健康。\n2. 助力长寿：核心是保障晚年生活质量，如食欲佳、睡眠安稳。","type":1}]},{"desc":"中医养生是长寿的核心","timestamp":182000,"detail":"","points":[{"desc":"・中医养生为长寿核心","detail":"1. 遵循天地规律：研究人体顺应天地的运行规律，关注气顺、血足、神安的状态，而非仅看表面指标。\n2. 忌过犹不及：若将健身单纯视为消耗过程而不注重养护，会成自杀式训练，不少运动员伤病缠身、寿命不及普通人就是例证。","type":1},{"desc":"・正确健康方式","detail":"1. 养用结合：以养生为根本，健身为辅助，先保证脾胃强健、肾精充足，再适度锻炼肌肉。\n2. 践行顺养：遵循温热饮食、顺应四时作息、进行八段锦等温和运动，养护内里，晚年能气色红润、精神矍铄。","type":1}]},{"desc":"结语","timestamp":228000,"detail":"","points":[]}],"chapter_recommend_type":1,"chapter_abstract":"健身和养生是两条不同的道路，健身追求短期的身体指标亮点，而养生追求长期的健康和长寿。中医养生强调能量和平衡，关注五脏六腑的机能，遵循自然规律。过度健身可能导致伤害，而养生则能让人保持良好的气色、心态和健康。真正的智者应以养生为体，健身为用。","chapter_recommend_source":2,"push_scene":[],"chapter_bar_color":null},"trends_infos":null,"chapter_bar_color":null,"flash_mob_trends":0,"ent_log_extra":{"log_extra":"{\"global_log_extra\":null,\"page_log_extra\":null,\"aweme_log_extra\":{\"ce_current_group_id\":\"7649981396135846062\",\"author_id\":\"109782134755\"},\"extra_log_extra\":null}"},"personal_page_botton_diagnose_style":0},{"aweme_id":"7649908576202818522","desc":"夏天吃热冬吃冷","create_time":1781133141,"author":{"uid":"109782134755","interest_tags":null,"nickname":"神龙（下期6月15日-17日线下课开课）","card_sort_priority":null,"user_tags":null,"avatar_thumb":{"uri":"100x100/aweme-avatar/tos-cn-avt-0015_c64b237be42afc21fa8b5fc32d8e9daa","url_list":["https://p3-pc.douyinpic.com/aweme/100x100/aweme-avatar/tos-cn-avt-0015_c64b237be42afc21fa8b5fc32d8e9daa.jpeg?from=327834062"],"width":720,"height":720},"private_relation_list":null,"endorsement_info_list":null,"follow_status":0,"special_people_labels":null,"hide_self_recommend_interest":0,"familiar_visitor_user":null,"custom_verify":"","display_info":null,"card_entries_not_display":null,"user_permissions":n