：用错配五行能量承接对方低频邪气，引发自身五行乘侮，表现为肝郁、纠结、决断出错","type":1}]},{"desc":"天人合一","timestamp":203000,"detail":"","points":[{"desc":"・天人合一的五行对应体系","detail":"1. 对应关系：天上五星对应人间五常、人体五脏，也对应福报与因果\n2. 修行核心：调平自身阴阳，将五行转到相生轨道，不强行干预他人因果\n3. 自利利人：自身五行顺生时，存在本身即利益世界，因果自流转、业力转清净、福报自至","type":1}]},{"desc":"结语","timestamp":240000,"detail":"","points":[]}],"chapter_recommend_type":1,"chapter_abstract":"福报、业力和因果是命运的重要组成部分。因果是阴阳的对立互根与消长平衡，业力是五行偏颇指数，福报是生命里的中土之气。修行的关键是调平衡自己的阴阳，把五行转到相生的轨道上，而不是强行干预别人的因果。","chapter_recommend_source":2,"push_scene":[],"chapter_bar_color":null},"trends_infos":null,"chapter_bar_color":null,"share_post_info":{"share_type":"video","is_open_platform":1,"open_platform_key":"aw7c4z4ej0o3efzd"},"flash_mob_trends":0,"ent_log_extra":{"log_extra":"{\"global_log_extra\":null,\"page_log_extra\":null,\"aweme_log_extra\":{\"ce_current_group_id\":\"7645575144957865674\",\"author_id\":\"952606616199739\"},\"extra_log_extra\":null}"},"personal_page_botton_diagnose_style":0,"aweme_type_tags":""},{"aweme_id":"7645554327222428658","desc":"家中无逆子，财从何处来","create_time":1780119335,"author":{"uid":"952606616199739","card_sort_priority":null,"nickname":"神龙院长(下期开课6月15日)","card_entries_not_display":null,"white_cover_url":null,"avatar_thumb":{"uri":"100x100/aweme-avatar/tos-cn-avt-0015_2d50790c927c9b8c3c38f8707ed4e8b0","url_list":["https://p3-pc.douyinpic.com/aweme/100x100/aweme-avatar/tos-cn-avt-0015_2d50790c927c9b8c3c38f8707ed4e8b0.jpeg?from=327834062"],"width":720,"height":720},"private_relation_list":null,"follower_list_secondary_information_struct":null,"follow_status":0,"not_seen_item_id_list_v2":null,"hide_self_recommend_interest":0,"special_people_labels":null,"custom_verify":"","card_entries":null,"cf_list":null,"link_item_list":null,"profile_component_disabled":null,"text_extra":null,"share_info":{"share_url":"","share_weibo_desc":"","share_desc":"","share_title":"","share_qrcode_url":{"uri":"","url_list":[],"width":720,"height":720},"share_title_myself":"","share_title_other":"","share_desc_i