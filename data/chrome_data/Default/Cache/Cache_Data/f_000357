star_altar_order_id":0,"star_altar_type":0,"item_id":0},"mark_largely_following":false,"friend_recommend_info":{"friend_recommend_source":10,"label_user_list":null,"disable_friend_recommend_guide_label":false},"enable_comment_sticker_rec":false,"video_share_edit_status":0,"is_24_story":0,"recommend_chapter_info":{"recommend_chapter_list":[{"desc":"引言","timestamp":0,"detail":"","points":[]},{"desc":"阴的含义","timestamp":20000,"detail":"","points":[{"desc":"・中医道家的“阴”定义","detail":"1. 核心内涵：中医道家里的阴指收敛内藏固封状态，不等于阴暗。\n2. 平衡法则：《黄帝内经》讲“阴平阳秘”，需阳气固密、阴气平衡。\n3. 能量关联：做好事产生的能量可在特定条件下转化为阴。","type":1}]},{"desc":"做好事不留名的原因","timestamp":35000,"detail":"","points":[{"desc":"・好事留名与不留名的能量差异","detail":"1. 留名能量走向：留名炫耀会让能量转为阳，因外界关注赞美消散。\n2. 不留名能量走向：默默付出时能量转为阴，注入身体形成内德。\n3. 中医原理支撑：对应中医“气归精”原理，滋养自身精气神。","type":1}]},{"desc":"许愿不说的原因","timestamp":74000,"detail":"","points":[{"desc":"・许愿不说的中医依据","detail":"1. 说话耗气本质：中医认为说话会牵动心火、肺气、肾气，属于耗气行为。\n2. 藏志与耗气区别：默默许愿是肾主藏志，志气下沉藏于丹田；说出来则肾气外泄、志气消散。\n3. 意念闭环影响：说出愿望会在意念系统里给事件画上句号，中断能量积累。","type":1}]},{"desc":"宇宙能量学解释","timestamp":114000,"detail":"","points":[{"desc":"・从能量学看默默行为的意义","detail":"1. 信号接收机制：宇宙靠心念频率而非声波接收信号，寂静状态下能量交换效率最高。\n2. 频率降维损耗：说出善念会将高频意念转化为低频声波，导致高频能量失真耗散。\n3. 观察者效应影响：好事被知晓后“我执”介入，能量场从无我转为有我，损耗能量。","type":1}]},{"desc":"福报的兑现","timestamp":157000,"detail":"","points":[{"desc":"・福报的两种兑现形式","detail":"1. 厚福形成逻辑：不说不留名时，福报势能留存，未来以健康、好运、贵人形式释放。\n2. 即时兑现弊端：留名炫耀会让势能转化为即时赞美、关注，福报提前消耗，价值大幅降低。\n3. 道德观契合：《道德经》认为“上德不德”，不刻意认为自己积德才是真有德。","type":1}]},{"desc":"结语","timestamp":206000,"detail":"","points":[]}],"chapter_recommend_type":1,"chapter_abstract":"阴德在中医和道家文化中被认为是一种内敛、内藏的能量，通过做好事不留名和默默许愿，可以将阳德转化为阴德，滋养经络、补肾藏志。这种做法有助于保持高频振动，直接对接宇宙能量场，从而获得更持久的福报。","chapter_recommend_source":2,"push_scene":[],"chapter_bar_color":null},"trends_infos":null,"chapter_bar_color":null,"flash_mob_trends":0,"ent_log_extra":{"log_extra":"{\"global_log_extra\":null,\"page_log_extra\":null,\"aweme_log_extra\":{\"ce_current_group_id\":\"7645295129428022857\",\"author_id\":\"952606616199739\"},