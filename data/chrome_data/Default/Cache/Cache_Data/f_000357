b_title":null,"market_info":{"limit_free":{"in_free":false},"marketing_tag":null}},"caption":"爱笑的人为什么命会更好","item_title":"","is_use_music":false,"original":0,"xigua_base_info":{"status":0,"star_altar_order_id":0,"star_altar_type":0,"item_id":0},"mark_largely_following":false,"friend_recommend_info":{"friend_recommend_source":10,"label_user_list":null,"disable_friend_recommend_guide_label":false},"enable_comment_sticker_rec":false,"video_share_edit_status":0,"is_24_story":0,"recommend_chapter_info":{"recommend_chapter_list":[{"desc":"引言","timestamp":0,"detail":"","points":[]},{"desc":"笑与人体气机","timestamp":11000,"detail":"","points":[]},{"desc":"笑与五行生克","timestamp":33000,"detail":"","points":[{"desc":"・笑开启五行生克良性循环","detail":"1. 火生土：心火温煦脾土，增强脾胃消化吸收能力，气血生化有源；\n2. 金生水：肺气肃降充养肾水，肾主骨生髓，筋骨头脑状态佳；\n3. 水生木：肾水涵养肝木，肝气不郁，情绪稳定筋骨柔韧","type":1},{"desc":"・自然笑是阴阳平衡信号","detail":"1. 正常表征：自然流露的笑，说明体内阴阳平衡、气血调和；\n2. 异常警示：强笑、苦笑等，是体内气息失调的信号","type":1}]},{"desc":"开怀大笑时身体的变化","timestamp":64000,"detail":"","points":[{"desc":"・开怀笑联动多经络脏腑","detail":"1. 心经通畅：心气充盈，心经气血流畅，面色红润神清气爽；\n2. 肺经调气：以呼气为主，排浊吸清，促进全身血脉流畅；\n3. 胃经舒展：牵动腹部胃经，提升消化能力，笑后易有饥饿感；\n4. 膻中穴按摩：震动气会膻中穴，疏解全身气机郁滞","type":1}]},{"desc":"笑与命和财富","timestamp":102000,"detail":"","points":[{"desc":"・爱笑塑造有福气场","detail":"1. 中医依据：正气存内，气机通畅气血充盈，面相舒展脚步轻快；\n2. 天地同频：笑对应夏季阳气舒展状态，与天地生发之气同频，事半功倍","type":1},{"desc":"・笑助财富流通聚集","detail":"1. 促流通：笑让气血通畅，使人思维敏捷、人脉顺畅；\n2. 反例警示：常年板脸易气滞血瘀肝郁脾虚，错失机遇","type":1}]},{"desc":"笑与健康","timestamp":139000,"detail":"","points":[{"desc":"・大笑调全身气机提免疫","detail":"1. 多脏调理：宣肺气、散肝郁、通心脉、运脾湿、降肾浊；\n2. 增强免疫：提升免疫细胞活性，卫气温煦腠理，外邪难侵","type":1},{"desc":"・笑是天然经络疏通法","detail":"1. 疏通原理：笑产生的震动冲开细小经络淤堵；\n2. 适用人群：尤适合久坐肩颈僵硬的人群","type":1}]},{"desc":"注意事项","timestamp":167000,"detail":"","points":[{"desc":"・并非所有笑都有益健康","detail":"1. 有害笑类型：狂笑不休（心气涣散心神不宁，反而伤身）、苦笑强笑假笑（动不了真气，消耗气血）；\n2. 有益笑标准：自然舒适、发自内心，心火有制肾水能济的笑","type":1}]},{"desc":"结语","timestamp":187500,"detail":"","points":[]}],"chapter_recommend_type":1,"chapter_abstract":"中医认为，爱笑的人运气好、命更好，因为笑能调动人体气机，使五脏和谐运动，打通五行生克的良性循环。真正的笑能让气血通畅，提升免疫细胞活性，改善健康，还能带来人缘、贵人运和财富。但要注意，狂笑、苦笑、强笑和假笑对身体无益。","chapter_recommend_source":2,"push_scene":[],"chapter_bar_color":null},"trends_infos":null,"chapter_bar_color":null,"share_post_info":{"share_type":"video","is_open_platform":1,"open_platform_key":"aw7c4z4ej0o3efzd"},"flash_mob_trends":0,"ent_log_extra":{"log_extra":"{\"global_log_extra\":null,\"page_log_extra\":null,\"aweme_log_extra\":{\"ce_current_group_id\":\"7645924944651509102\",\"author_id\":\"952606616199739\"},\"extra_log_extra\":null}"},"personal_page_botton_diagnose_style":0,"aweme_type_tags":""},{"aweme_id":"7645575144957865674","desc":"福报 因果 业力到底是什么","create_time":1780124182,"author":{"uid":"952606616199739","card_sort_priority":null,"nickname":"神龙院长(下期开课6月15日)","card_entries_not_display":null,"white_cover_url":null,"avatar_thumb":{"uri":"100x100/aweme-avatar/tos-cn-avt-0015_2d50790c927c9b8c3c38f8707ed4e8b0","url_list":["https://p3-pc.douyinpic.com/aweme/100x100/aweme-avatar/tos-cn-avt-0015_2d50790c927c9b8c3c38f8707ed4e8b0.jpeg?from=327834062"],"width":720,"height":720},"private_relation_list":null,"follower_list_secondary_information_struct":null,"follow_status":0,"not_seen_item_id_list_v2":null,"hide_self_recommend_interest":0,"special_people_labels":null,"custom_verify":"","card_entries":null,"cf_list":null,"link_item_list":null,"profile_component_disabled":null,"text_extra":null,"share_info":{"share_url":"","share_weibo_desc":"","share_desc":"","share_title":"","share_qrcode_url":{"uri":"","url_list":[],"width":720,"height":720},"share_title_myself":"","share_title_other":"","share_desc_info":""},"user_tags":null,"ban_user_functions":null,"can_set_geofencing":null,"enterprise_verify_reason":"","is_ad_fake":false,"hide_others_recommend_interest":0,"offline_info_list":null,"im_role_ids":null,"identity_labels":null,"signature_extra":null,"data_label_list":null,"interest_tags":null,"prevent_download":false,"avatar_schema_list":null,"homepage_bottom_toast":null,"contrail_list":null,