ogress":0,"last_modified_time":0},"reply_smart_emojis":null,"activity_video_type":0,"boost_status":0,"create_scale_type":null,"entertainment_product_info":{"sub_title":null,"market_info":{"limit_free":{"in_free":false},"marketing_tag":null}},"caption":"善有善报吗？","item_title":"","is_use_music":false,"original":0,"xigua_base_info":{"status":0,"star_altar_order_id":0,"star_altar_type":0,"item_id":0},"mark_largely_following":false,"friend_recommend_info":{"friend_recommend_source":10,"label_user_list":null,"disable_friend_recommend_guide_label":false},"enable_comment_sticker_rec":false,"video_share_edit_status":0,"is_24_story":0,"recommend_chapter_info":{"recommend_chapter_list":[{"desc":"引言","timestamp":0,"detail":"","points":[]},{"desc":"相同点","timestamp":6500,"detail":"","points":[{"desc":"・善恶观核心：因果不虚","detail":"1. 底层逻辑：两句话均遵循能量守恒、天人合一理念，行为与念头是体内气的流动。\n2. 气机对应：善念善行对应肝木气条达、心火宣通；恶念恶行对应肾寒气凝滞、肺郁闭。\n3. 天道法则：给出的能量最终会回到自身，气必须找到释放出口。","type":1}]},{"desc":"矛盾点","timestamp":40500,"detail":"","points":[{"desc":"・善恶报的矛盾根源","detail":"1. 认知偏差：多数人认为报应是即时反馈，中医认为是动态气化过程。\n2. 好人假象：老好人憋气伤肝，淤结化病，实为不懂疏泄郁气的自伤。\n3. 恶人表象：恶人发火排郁气短期爽，但刚暴之气伤肾精心血，后期必遭报应。","type":1}]},{"desc":"善的真正标准","timestamp":81500,"detail":"","points":[{"desc":"・善的真正评判标准","detail":"1. 核心原则：善是和合中正，而非一味退让。\n2. 五行适配：肝属木需生发有度，过退伤脾致思虑重、肌肉松软；心属火需热情有边界，无界损判断力；肾属水需善对人，盲目行善耗肾精。\n3. 误区纠正：好人没好报是善变“死善”，不懂五行流转规律。","type":1}]},{"desc":"恶报的快慢","timestamp":114000,"detail":"","points":[{"desc":"・恶报快慢的影响因素","detail":"1. 关联依据：恶报快慢取决于经络堵塞的速度。\n2. 对应经络：算计他人易堵手少阴心经，致心不藏神、半夜三点醒；背后害人易堵足少阳胆经，致决断力下降、优柔寡断。\n3. 显现时机：恶气积累后，待气血下坡、正气虚弱时集中爆发。","type":1}]},{"desc":"如何运用","timestamp":140000,"detail":"","points":[{"desc":"・善恶观的实践方法","detail":"1. 正确行善：不做报表式的善，先调自身十二条经络气血通畅，避免带怨气行善自伤肝血。\n2. 正视恶报：恶报是筋膜失去弹性、睡眠变浅等身体变化，是现实报。\n3. 及时止损：察觉贪念嗔恨，立刻调呼吸按膻中通三焦排恶气，治未病以免后患。\n4. 核心准则：以阴阳平衡为根，气血通畅为路，善而不执，恶而不纵。","type":1}]}],"chapter_recommend_type":1,"chapter_abstract":"中医智慧揭示了善有善报、恶有恶报的真相。因果不虚，能量守恒，善念善行对应身体的健康，恶念恶行对应身体的疾病。好人没好报是因为误解了善或在善中丢失了自己。真正的善是和合中正，要懂得五行流转。恶报来的快慢取决于经络堵塞的速度