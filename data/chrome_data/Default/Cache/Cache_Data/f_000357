tail":"1. 运化功能统一：单一嘴巴保证进食、说话功能统一，避免脾胃运化混乱；\n2. 土属性匹配：脾属土主中央，对应单一的口，符合中土唯一的中医法则","type":1}]},{"desc":"结语","timestamp":378000,"detail":"","points":[]}],"chapter_recommend_type":1,"chapter_abstract":"中医认为人体的五脏五窍与天地相对应，数量和功能都有其合理性。心、肺、肝、脾各有一个，肾有两个，分别对应着天上的太阳、月亮、长江、黄河。五窍的数量也与脏腑功能和特点相匹配，如舌头对应心，眼睛对应肝，鼻孔对应肺，耳朵对应肾，嘴巴对应脾。这种天人合一的观念揭示了人体与宇宙之间的紧密联系。","chapter_recommend_source":2,"push_scene":[1],"chapter_bar_color":null},"trends_infos":null,"chapter_bar_color":null,"share_post_info":{"share_type":"video","is_open_platform":1,"open_platform_key":"aw7c4z4ej0o3efzd"},"flash_mob_trends":0,"ent_log_extra":{"log_extra":"{\"global_log_extra\":null,\"page_log_extra\":null,\"aweme_log_extra\":{\"ce_current_group_id\":\"7650453626972767434\",\"author_id\":\"952606616199739\"},\"extra_log_extra\":null}"},"personal_page_botton_diagnose_style":0,"aweme_type_tags":""},{"aweme_id":"7650352505764008138","desc":"善有善报吗？","create_time":1781236498,"author":{"uid":"952606616199739","card_sort_priority":null,"nickname":"神龙院长(下期开课6月15日)","card_entries_not_display":null,"white_cover_url":null,"avatar_thumb":{"uri":"100x100/aweme-avatar/tos-cn-avt-0015_2d50790c927c9b8c3c38f8707ed4e8b0","url_list":["https://p3-pc.douyinpic.com/aweme/100x100/aweme-avatar/tos-cn-avt-0015_2d50790c927c9b8c3c38f8707ed4e8b0.jpeg?from=327834062"],"width":720,"height":720},"private_relation_list":null,"follower_list_secondary_information_struct":null,"follow_status":0,"not_seen_item_id_list_v2":null,"hide_self_recommend_interest":0,"special_people_labels":null,"custom_verify":"","card_entries":null,"cf_list":null,"link_item_list":null,"profile_component_disabled":null,"text_extra":null,"share_info":{"share_url":"","share_weibo_desc":"","share_desc":"","share_title":"","share_qrcode_url":{"uri":"","url_list":[],"width":720,"height":720},"share_title_myself":"","share_title_other":"","share_desc_info":""},"user_tags":null,"ban_user_functions":null,"can_set_geofencing":null,"enterprise_verify_reason":"","is_ad_fake":false,"hide_oth