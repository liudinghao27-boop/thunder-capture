n\n### 自查建议  \n- 本人查：派出所开无犯罪记录、征信报告、清理纹身；  \n- 家属查：父母查无犯罪+失信；  \n- 疑问带材料咨询鹤岗工农公安政工，别等分数够再补！  \n（注：非公安专业、司法警校标准稍松，以本校章程为准）"},"type":2}],"hide_action_bar":0,"hide_analysis_bar":0,"hit_cache":false,"hit_security_check":false,"is_end":false,"is_user_auth":0,"key":"segk_20260615122928CC045C35CF6D62D50F1A_4","next_key":"segk_20260615122928CC045C35CF6D62D50F1A_5","next_sse_key":"ssek_20260615122928CC045C35CF6D62D50F1A_2","res_type":0,"ret_message":"","search_id":"20260615122928CC045C35CF6D62D50F1A","security_message":"","sse_key":"ssek_20260615122928CC045C35CF6D62D50F1A_1","trace_info":{"ai_search_send_timestamp_ms":1781497768609,"ai_search_source_type":"ai_top1_offline_search","card_level":2,"enter_from_second":"top1","generation_type":2,"hit_cache":1,"segment_get_timestamp_ms":1781497768543}},"doc_id":"733128794","search_id":"20260615122928CC045C35CF6D62D50F1A"},"info":{"cache_search_id":"20260612213321D07F58E9C6E26E4635C9"},"is_end":false,"key":"segk_20260615122928CC045C35CF6D62D50F1A_4","next_key":"segk_20260615122928CC045C35CF6D62D50F1A_5","search_id":"20260615122928CC045C35CF6D62D50F1A","voice_cmd":""},{"args":{"aladdin_rank":0,"card_level":2,"data_type":"","disable_typewriter_effect":false,"hit_cache":false,"id":"20260615122928CC045C35CF6D62D50F1A_2","insert_action":"","insert_id":"","is_general_search_online":false,"parent_id":"20260615122928CC045C35CF6D62D50F1A_1","rank":0,"render_next_after_finished":false,"replace_id":""},"chunk_end":false,"cmd":"Append","display":{"answer_online_general_search_id":"20260615122921B9E56B874105AFB2BD3E","display":{"debug_info":"","generation_spans":[{"meta_status":{"status":26},"type":4}],"hide_action_bar":0,"hide_analysis_bar":0,"hit_cache":false,"hit_security_check":false,"is_end":false,"is_user_auth":0,"key":"segk_20260615122928CC045C35CF6D62D50F1A_5","next_key":"segk_20260615122928CC045C35CF6D62D50F1A_6","next_sse_key":"ssek_20260615122928CC045C35CF6D62D50F1A_2","res_type":0,"ret_message":"","search_id":"20260615122928CC045C35