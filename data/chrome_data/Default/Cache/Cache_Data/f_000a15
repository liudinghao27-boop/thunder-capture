短晋升。  \n\n具体以部队岗位编制和当年选晋通知为准，可查全国征兵网或咨询武装部。"},"type":2}],"hide_action_bar":0,"hide_analysis_bar":0,"hit_cache":false,"hit_security_check":false,"is_end":false,"is_user_auth":0,"key":"segk_20260615125351EA3022CEB045FBE83CB0_4","next_key":"segk_20260615125351EA3022CEB045FBE83CB0_5","next_sse_key":"ssek_20260615125351EA3022CEB045FBE83CB0_2","res_type":0,"ret_message":"","search_id":"20260615125351EA3022CEB045FBE83CB0","security_message":"","sse_key":"ssek_20260615125351EA3022CEB045FBE83CB0_1","trace_info":{"ai_search_send_timestamp_ms":1781499231751,"ai_search_source_type":"ai_top1_offline_search","card_level":2,"enter_from_second":"top1","generation_type":2,"hit_cache":1,"segment_get_timestamp_ms":1781499231683}},"doc_id":"4174737119","search_id":"20260615125351EA3022CEB045FBE83CB0"},"info":{"cache_search_id":"20260613135747CB086085F666722890CA"},"is_end":false,"key":"segk_20260615125351EA3022CEB045FBE83CB0_4","next_key":"segk_20260615125351EA3022CEB045FBE83CB0_5","search_id":"20260615125351EA3022CEB045FBE83CB0","voice_cmd":""},{"args":{"aladdin_rank":0,"card_level":2,"data_type":"","disable_typewriter_effect":false,"hit_cache":false,"id":"20260615125351EA3022CEB045FBE83CB0_2","insert_action":"","insert_id":"","is_general_search_online":false,"parent_id":"20260615125351EA3022CEB045FBE83CB0_1","rank":0,"render_next_after_finished":false,"replace_id":""},"chunk_end":false,"cmd":"Append","display":{"answer_online_general_search_id":"202606151253488B006A6F8C983DB67B43","display":{"debug_info":"","generation_spans":[{"meta_status":{"status":26},"type":4}],"hide_action_bar":0,"hide_analysis_bar":0,"hit_cache":false,"hit_security_check":false,"is_end":false,"is_user_auth":0,"key":"segk_20260615125351EA3022CEB045FBE83CB0_5","next_key":"segk_20260615125351EA3022CEB045FBE83CB0_6","next_sse_key":"ssek_20260615125351EA3022CEB045FBE83CB0_2","res_type":0,"ret_message":"","search_id":"20260615125351EA3022CEB045FBE83CB0","security_message":"","sse_key":"ssek_20260615125351EA3022CEB04