.cn/，咨询：027-12345转征兵办。"},"type":2}],"hide_action_bar":0,"hide_analysis_bar":0,"hit_cache":false,"hit_security_check":false,"is_end":false,"is_user_auth":0,"key":"segk_202606160127316606C5F61CEBB3EF5BE3_4","next_key":"segk_202606160127316606C5F61CEBB3EF5BE3_5","next_sse_key":"ssek_202606160127316606C5F61CEBB3EF5BE3_2","res_type":0,"ret_message":"","search_id":"202606160127316606C5F61CEBB3EF5BE3","security_message":"","sse_key":"ssek_202606160127316606C5F61CEBB3EF5BE3_1","trace_info":{"ai_search_send_timestamp_ms":1781544452000,"ai_search_source_type":"ai_top1_offline_search","card_level":2,"enter_from_second":"top1","generation_type":2,"hit_cache":1,"segment_get_timestamp_ms":1781544451956}},"doc_id":"1472690962","search_id":"202606160127316606C5F61CEBB3EF5BE3"},"info":{"cache_search_id":"2026061313543654CD2E612E74332D4007S1"},"is_end":false,"key":"segk_202606160127316606C5F61CEBB3EF5BE3_4","next_key":"segk_202606160127316606C5F61CEBB3EF5BE3_5","search_id":"202606160127316606C5F61CEBB3EF5BE3","voice_cmd":""},{"args":{"aladdin_rank":0,"card_level":2,"data_type":"","disable_typewriter_effect":false,"hit_cache":false,"id":"202606160127316606C5F61CEBB3EF5BE3_2","insert_action":"","insert_id":"","is_general_search_online":false,"parent_id":"202606160127316606C5F61CEBB3EF5BE3_1","rank":0,"render_next_after_finished":false,"replace_id":""},"chunk_end":false,"cmd":"Append","display":{"answer_online_general_search_id":"20260616012709C91932BE4A8717ADCDD7","display":{"debug_info":"","generation_spans":[{"meta_status":{"status":26},"type":4}],"hide_action_bar":0,"hide_analysis_bar":0,"hit_cache":false,"hit_security_check":false,"is_end":false,"is_user_auth":0,"key":"segk_202606160127316606C5F61CEBB3EF5BE3_5","next_key":"segk_202606160127316606C5F61CEBB3EF5BE3_6","next_sse_key":"ssek_202606160127316606C5F61CEBB3EF5BE3_2","res_type":0,"ret_message":"","search_id":"202606160127316606C5F61CEBB3EF5BE3","security_message":"","sse_key":"ssek_202606160127316606C5F61CEBB3EF5BE3_1","trace